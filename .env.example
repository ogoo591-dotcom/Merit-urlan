# Үүнийг хуулж .env.local болгоод утгуудыг бөглөнө. .env.local git-д орохгүй.

# Supabase → Project Settings → Database → Connection string
# App: Transaction pooler (6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# Migration: Direct connection (5432)
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase Storage (зураг: media bucket, схем: private bucket) — Project Settings → API Keys → Secret key. Зөвхөн сервер.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clerk → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → endpoint (/api/webhooks/clerk) → Signing Secret (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=

# Таслалаар тусгаарласан админы имэйлүүд
ADMIN_EMAILS=
# ТҮР: true бол локал dev-д админ шалгалтыг алгасна (production build-д ажиллахгүй)
ADMIN_AUTH_BYPASS=

# QPay callback-ийн үндсэн хаяг
APP_URL=http://localhost:3000

# mock | qpay
PAYMENT_PROVIDER=mock
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
